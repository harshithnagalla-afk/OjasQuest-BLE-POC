# Firebase Web SDK config — from Firebase Console > Project settings > General
# > Your apps > Web app. These values are public by design (they identify
# your Firebase project, they are not secrets); real access control is
# enforced by Firebase Auth + your backend + Firestore security rules, not
# by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Where the API is running. Only needed for LOCAL DEV against the Express
# server in backend/ (different port than the frontend). Leave this unset
# on Vercel — api/ is deployed on the same domain as the built frontend, so
# the app calls it with a relative /api/... URL automatically.
VITE_API_BASE_URL=http://localhost:4000
